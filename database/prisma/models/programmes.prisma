// Programme and cohort management models.

model Programme {
  id          String    @id @default(uuid()) @db.Uuid
  code        String?   @unique @db.VarChar(50)
  name        String    @unique @db.VarChar(200)
  slug        String    @unique @db.VarChar(220)
  description String?   @db.Text
  programmeType   String?  @map("programme_type") @db.VarChar(100)
  targetAudience  String?  @map("target_audience") @db.VarChar(500)
  durationWeeks   Int?     @map("duration_weeks")
  deliveryMode    String?  @map("delivery_mode") @db.VarChar(100)
  coverImageUrl   String?  @map("cover_image_url") @db.VarChar(500)
  learningObjectives String[] @default([]) @map("learning_objectives")
  programContent String[] @default([]) @map("program_content")
  eligibility     String?  @db.Text
  status      String    @default("draft") @db.VarChar(50)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cohorts           Cohort[]
  assignments       ProgrammeAssignment[]
  resources         ResourceProgramme[]
  announcements     AnnouncementProgrammeTarget[]
  mentorAssignments MentorAssignment[]
  progressPolicy    ProgrammeProgressPolicy?
  feeDefinitions    FeeDefinition[]

  @@map("programmes")
}

model Cohort {
  id          String    @id @default(uuid()) @db.Uuid
  programmeId String    @map("programme_id") @db.Uuid
  name        String    @db.VarChar(200)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  capacity    Int?
  status      String    @default("planned") @db.VarChar(50)
  progressRevision Int  @default(0) @map("progress_revision")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  programme     Programme                  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  enrollments   Enrollment[]
  assignments   CohortAssignment[]
  resources     ResourceCohort[]
  announcements AnnouncementCohortTarget[]
  progressPolicy CohortProgressPolicy?
  registrationRequests ProgrammeRegistrationRequest[]
  registrationFee CohortRegistrationFee?

  @@unique([programmeId, name])
  @@index([programmeId])
  @@map("cohorts")
}

model CohortRegistrationFee {
  cohortId String @id @map("cohort_id") @db.Uuid
  feeId String? @map("fee_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  fee FeeDefinition? @relation(fields: [feeId], references: [id], onDelete: Restrict)
  @@map("cohort_registration_fees")
}

model ProgrammeRegistrationRequest {
  id String @id @default(uuid()) @db.Uuid
  memberId String @map("member_id") @db.Uuid
  cohortId String @map("cohort_id") @db.Uuid
  status String @default("pending") @db.VarChar(30)
  reason String? @db.Text
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  chargeId String? @unique @map("charge_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  charge MemberCharge? @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  @@unique([memberId, cohortId])
  @@index([cohortId, status, createdAt])
  @@map("programme_registration_requests")
}

model Enrollment {
  id          String    @id @default(uuid()) @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  cohortId    String    @map("cohort_id") @db.Uuid
  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  status      String    @default("enrolled") @db.VarChar(50)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  progress EnrollmentProgress?

  @@unique([memberId, cohortId])
  @@index([cohortId])
  @@map("enrollments")
}

model ProgrammeProgressPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  programmeId       String   @unique @map("programme_id") @db.Uuid
  attendanceMinimum Int?     @map("attendance_minimum")
  deliverables      Json     @default("[]")
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  programme         Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  @@map("programme_progress_policies")
}

model CohortProgressPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  cohortId          String   @unique @map("cohort_id") @db.Uuid
  attendanceMinimum Int?     @map("attendance_minimum")
  deliverables      Json     @default("[]")
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cohort            Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  @@map("cohort_progress_policies")
}

model EnrollmentProgress {
  id                String   @id @default(uuid()) @db.Uuid
  enrollmentId      String   @unique @map("enrollment_id") @db.Uuid
  attendanceAttended Int?    @map("attendance_attended")
  attendanceTotal   Int?     @map("attendance_total")
  completedDeliverables Json @default("[]") @map("completed_deliverables")
  approvedPolicyKey String?  @map("approved_policy_key") @db.VarChar(100)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  @@map("enrollment_progress")
}

model ProgrammeAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  programmeId    String   @map("programme_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  assignmentRole String   @map("assignment_role") @db.VarChar(100)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  status         String   @default("active") @db.VarChar(50)

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([programmeId, userId, assignmentRole])
  @@index([userId])
  @@map("programme_assignments")
}

model CohortAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  cohortId       String   @map("cohort_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  assignmentRole String   @map("assignment_role") @db.VarChar(100)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  status         String   @default("active") @db.VarChar(50)

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([cohortId, userId, assignmentRole])
  @@index([userId])
  @@map("cohort_assignments")
}
