enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// Identity and access management models.

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users               User[]
  permissions         RolePermission[]
  announcementTargets AnnouncementRoleTarget[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(150)
  description String? @db.Text

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  roleId            String        @map("role_id") @db.Uuid
  email             String        @unique @db.VarChar(255)
  passwordHash      String        @map("password_hash") @db.Text
  firstName         String        @map("first_name") @db.VarChar(100)
  lastName          String        @map("last_name") @db.VarChar(100)
  phone             String?       @db.VarChar(30)
  location          String?       @db.VarChar(255)
  dateOfBirth       DateTime?     @map("date_of_birth") @db.Date
  gender            String?       @db.VarChar(50)
  nationality       String?       @db.VarChar(100)
  preferredLanguage String?       @map("preferred_language") @db.VarChar(5)
  timezone          String?       @db.VarChar(100)
  bio               String?       @db.VarChar(250)
  status            AccountStatus @default(PENDING_ACTIVATION)
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  role          Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  memberProfile Member?
  mentorProfile Mentor?
  profilePhoto  MemberProfilePhoto?

  membershipApplications MembershipApplication[]
  applicationsReviewed   MembershipApplication[]  @relation("MembershipApplicationReviewer")
  activationTokens       AccountActivationToken[]
  revokedAccessTokens    RevokedAccessToken[]
  passwordResetTokens    PasswordResetToken[]

  // Programme and cohort assignments
  programmeAssignments ProgrammeAssignment[]
  cohortAssignments    CohortAssignment[]

  // Resource uploads
  resourcesUploaded        Resource[]
  resourceVersionsUploaded ResourceVersion[] @relation("ResourceVersionUploader")

  // Events
  eventsCreated         Event[]
  eventStaffAssignments EventStaffAssignment[]

  // Mentorship progress
  progressRecordsRecorded MentoringProgressRecord[]

  // Announcements and notifications
  announcementsCreated    Announcement[]
  notifications           Notification[]
  communicationDeliveries CommunicationDelivery[]

  // Messaging
  conversationsCreated    Conversation[]            @relation("ConversationCreator")
  conversationMemberships ConversationParticipant[] @relation("ConversationMemberships")
  messagesSent            Message[]                 @relation("MessageSender")

  // Business directory
  businessReviewsGiven BusinessReview[] @relation("BusinessReviewer")

  // Website content
  pagesCreated Page[] @relation("PageCreator")
  pagesUpdated Page[] @relation("PageUpdater")
  newsAuthored News[] @relation("NewsAuthor")

  // Contact enquiries
  contactEnquiriesSubmitted ContactEnquiry[] @relation("EnquirySubmitter")
  contactEnquiriesAssigned  ContactEnquiry[] @relation("EnquiryAssignee")

  // System auditing and configuration
  auditLogs             AuditLog[]
  systemSettingsUpdated SystemSetting[]

  @@index([roleId])
  @@map("users")
}

model RevokedAccessToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenId   String   @unique @map("token_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_access_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Member {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  membershipNo     String?   @unique @map("membership_no") @db.VarChar(100)
  joinedAt         DateTime? @map("joined_at") @db.Timestamptz(6)
  membershipStatus String    @default("active") @map("membership_status") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  eventRegistrations  EventRegistration[]
  mentorAssignments   MentorAssignment[]
  announcementTargets AnnouncementMemberTarget[]
  businesses          Business[]

  @@map("members")
}

model MemberProfilePhoto {
  userId      String   @id @map("user_id") @db.Uuid
  contentType String   @map("content_type") @db.VarChar(50)
  data        Bytes    @db.ByteA
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_profile_photos")
}

model Mentor {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  expertise              String?  @db.Text
  professionalBackground String?  @map("professional_background") @db.Text
  availability           String?  @db.Text
  status                 String   @default("active") @db.VarChar(50)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments MentorAssignment[]

  @@map("mentors")
}
