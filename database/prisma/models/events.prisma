// Event management, registrations, staffing, and media models.

model Event {
  id                   String    @id @default(uuid()) @db.Uuid
  title                String    @db.VarChar(250)
  description          String?   @db.Text
  eventType            String    @map("event_type") @db.VarChar(100)
  startAt              DateTime  @map("start_at") @db.Timestamptz(6)
  endAt                DateTime? @map("end_at") @db.Timestamptz(6)
  timezone             String?   @db.VarChar(100)
  venue                String?   @db.VarChar(255)
  meetingUrl           String?   @map("meeting_url") @db.VarChar(1000)
  registrationDeadline DateTime? @map("registration_deadline") @db.Timestamptz(6)
  capacity             Int?
  status               String    @default("draft") @db.VarChar(50)
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy        User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  registrations    EventRegistration[]
  staffAssignments EventStaffAssignment[]
  media            EventMedia[]

  @@index([createdByUserId])
  @@index([startAt])
  @@index([status])
  @@map("events")
}

model EventRegistration {
  id                 String    @id @default(uuid()) @db.Uuid
  eventId            String    @map("event_id") @db.Uuid
  memberId           String?   @map("member_id") @db.Uuid
  guestName          String?   @map("guest_name") @db.VarChar(200)
  guestEmail         String?   @map("guest_email") @db.VarChar(255)
  guestPhone         String?   @map("guest_phone") @db.VarChar(30)
  registrationStatus String    @default("registered") @map("registration_status") @db.VarChar(50)
  attendanceStatus   String    @default("pending") @map("attendance_status") @db.VarChar(50)
  registeredAt       DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([memberId])
  @@map("event_registrations")
}

model EventStaffAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  staffRole  String   @map("staff_role") @db.VarChar(100)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId, staffRole])
  @@index([userId])
  @@map("event_staff_assignments")
}

model EventMedia {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(500)
  mediaType  String   @map("media_type") @db.VarChar(100)
  caption    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_media")
}
