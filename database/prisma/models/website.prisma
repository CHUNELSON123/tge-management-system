// Website pages, news, contact enquiries, and newsletter subscriptions.

model Page {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique @db.VarChar(280)
  title           String    @db.VarChar(250)
  content         String    @db.Text
  status          String    @default("draft") @db.VarChar(50)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User  @relation("PageCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User? @relation("PageUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([status])
  @@map("pages")
}

model News {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique @db.VarChar(280)
  title            String    @db.VarChar(250)
  summary          String?   @db.Text
  content          String    @db.Text
  featuredImageKey String?   @map("featured_image_key") @db.VarChar(500)
  status           String    @default("draft") @db.VarChar(50)
  authorUserId     String    @map("author_user_id") @db.Uuid
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  author User @relation("NewsAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([authorUserId])
  @@index([status])
  @@index([publishedAt])
  @@map("news")
}

model ContactEnquiry {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  name             String    @db.VarChar(200)
  email            String    @db.VarChar(255)
  subject          String    @db.VarChar(250)
  message          String    @db.Text
  status           String    @default("new") @db.VarChar(50)
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  submitter  User? @relation("EnquirySubmitter", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("EnquiryAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assignedToUserId])
  @@index([status])
  @@map("contact_enquiries")
}

model NewsletterSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  status         String    @default("subscribed") @db.VarChar(50)
  subscribedAt   DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  consentSource  String?   @map("consent_source") @db.VarChar(150)

  @@index([status])
  @@map("newsletter_subscriptions")
}
