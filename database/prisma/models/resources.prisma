// Resource library and resource versioning models.

model ResourceCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(150)
  description String? @db.Text

  resources Resource[]

  @@map("resource_categories")
}

model Resource {
  id               String    @id @default(uuid()) @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  title            String    @db.VarChar(250)
  description      String?   @db.Text
  resourceType     String    @map("resource_type") @db.VarChar(100)
  accessLevel      String    @map("access_level") @db.VarChar(50)
  status           String    @default("draft") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  category      ResourceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uploadedBy    User                   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  versions      ResourceVersion[]
  programmes    ResourceProgramme[]
  cohorts       ResourceCohort[]
  announcements AnnouncementResource[]

  @@index([categoryId])
  @@index([uploadedByUserId])
  @@map("resources")
}

model ResourceVersion {
  id               String   @id @default(uuid()) @db.Uuid
  resourceId       String   @map("resource_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  storageKey       String   @map("storage_key") @db.VarChar(500)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(150)
  fileSize         BigInt   @map("file_size")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("ResourceVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([resourceId, versionNumber])
  @@index([uploadedByUserId])
  @@map("resource_versions")
}

model ResourceProgramme {
  resourceId  String   @map("resource_id") @db.Uuid
  programmeId String   @map("programme_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  resource  Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([resourceId, programmeId])
  @@map("resource_programmes")
}

model ResourceCohort {
  resourceId String   @map("resource_id") @db.Uuid
  cohortId   String   @map("cohort_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([resourceId, cohortId])
  @@map("resource_cohorts")
}
