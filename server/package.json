{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "main": "dist/main.js",
    "scripts": {
        "test": "node scripts/run-tests.mjs",
        "predev": "npm --prefix ../database run db:generate",
        "dev": "tsx watch src/main.ts",
        "prebuild": "npm --prefix ../database run db:generate",
        "build": "tsc",
        "start": "node dist/main.js",
        "test:admin-controls": "tsx --test src/modules/admin-portal/domain/account-lifecycle.test.ts src/modules/admin-portal/domain/website-content-lifecycle.test.ts src/modules/admin-portal/presentation/dto/admin-website.dto.test.ts src/modules/admin-portal/presentation/dto/admin-report-range.dto.test.ts src/modules/admin-portal/infrastructure/prisma-admin-audit.repository.test.ts",
        "typecheck": "tsc --noEmit",
        "test:foundation-registration": "tsx --test src/modules/programme-registration/programme-registration.e2e.test.ts",
        "test:mentorship-delivery": "tsx --test src/modules/mentorship-delivery/mentorship-delivery.e2e.test.ts src/modules/programme-progression/progression.test.ts"
    },
    "keywords": [],
    "type": "module",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "database": "file:../database",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "resend": "^6.36.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.5",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "esbuild@0.28.2": true
    }
}
